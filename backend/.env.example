# Server
NODE_ENV=production
PORT=5000

# Database (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/resolvex?retryWrites=true&w=majority

# Client URL (Your frontend Vercel URL, without trailing slash)
CLIENT_URL=https://your-frontend-app.vercel.app

# JWT Secrets (Generate random 32+ character strings)
JWT_ACCESS_SECRET=your-32-character-random-access-secret-key-here
JWT_REFRESH_SECRET=your-32-character-random-refresh-secret-key-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SLA Engine
ENABLE_SLA_JOB=true
SLA_WARNING_MINUTES=60

# Optional Cloudinary (for file attachments)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
